# Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key - server-side only, never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret used to verify Supabase-issued access tokens
# Supabase project settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# Matching weights (must sum to 1.0) - used from Phase 5 onward
MATCH_WEIGHT_IMAGE=0.45
MATCH_WEIGHT_TEXT=0.35
MATCH_WEIGHT_LOCATION=0.10
MATCH_WEIGHT_DATE=0.10

# Match category thresholds - used from Phase 5 onward
MATCH_THRESHOLD_STRONG=80
MATCH_THRESHOLD_POSSIBLE=60
